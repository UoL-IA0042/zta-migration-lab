# Managed by ansible-openziti/site.yaml. Private router on tpi2-4: no link
# listener (--private); it dials the controller and the public router, so
# nothing at home listens for the overlay. Hosts the on-prem services.
services:
  ziti-router:
    image: {{ ziti_router_image }}
    restart: unless-stopped
    network_mode: host
    user: "{{ ziti_uid }}"
    command: run config.yml
    environment:
      ZITI_CTRL_ADVERTISED_ADDRESS: {{ ziti_ctrl_host }}
      ZITI_CTRL_ADVERTISED_PORT: "{{ ziti_ctrl_port }}"
      ZITI_ENROLL_TOKEN: /ziti-router/enroll.jwt   # used only until enrolled
      ZITI_ROUTER_NAME: {{ ziti_lab_router }}
      # Required by the bootstrap; this router's edge listener is not
      # reachable from outside (ufw default-deny incoming on tpi2-4).
      ZITI_ROUTER_ADVERTISED_ADDRESS: {{ inventory_hostname }}
      ZITI_ROUTER_PORT: "{{ ziti_router_port }}"
      ZITI_ROUTER_MODE: host
      ZITI_BOOTSTRAP_CONFIG_ARGS: --private
    volumes:
      - {{ ziti_install_dir }}/router:/ziti-router
    healthcheck:
      test: [CMD, ziti, agent, stats]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 15s
